# Copier ce fichier vers .env puis renseigner vos propres valeurs.
# Ne jamais committer le fichier .env.

# "simulation" (par defaut, aucune configuration requise) ou "real"
EMAIL_MODE=simulation

# IMAP (reception)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=votre_adresse@gmail.com
IMAP_PASSWORD=votre_mot_de_passe_application
IMAP_MAILBOX=INBOX

# SMTP (envoi)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre_adresse@gmail.com
SMTP_PASSWORD=votre_mot_de_passe_application
SMTP_FROM=votre_adresse@gmail.com

# Alertes
ALERT_TO=votre_adresse@gmail.com
ALERT_SEND_EMAIL=false
